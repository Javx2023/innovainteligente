# Copia este archivo a .env y cambia los valores. No subas .env al repositorio.
APP_PORT=8080

# Acceso al panel de leads (obligatorio en producción)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia-esta-clave-larga

# Correo de recepción de los formularios
LEADS_EMAIL_TO=javier@innovainteligente.com

# SMTP para enviar el aviso por correo (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
